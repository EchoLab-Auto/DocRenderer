{
  "name": "@prodoc/core",
  "version": "0.1.0",
  "description": "ProDoc 核心库 - 文档解析与数据模型",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.js",
      "require": "./dist/pure.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "mermaid": "^10.9.6",
    "@echolab-auto/ui-frame": "^1.1.1"
  },
  "devDependencies": {
    "@echolab-auto/ui-frame": "^1.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  }
}
